<html>
    <head>
        <title><%= title %></title>
        <link rel="stylesheet" href="/styles.css">
    </head>
    <body>
        <a href="/new">Add new Message</a>
        <ul>
            <% if (locals.messages) { %>
                <% locals.messages.forEach((message) => { %>
                    <%- include('messages/message', {message: message}); %>
                <% }); %>
            <% } %>
        </ul>
        <form action="/deleteMessages">
            <button>Delete All Messages</button>
        </form>
    </body>
</html>